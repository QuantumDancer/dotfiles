# Global mise config — the source of truth for the portable toolchain.
# Identical on every machine. Docs: https://mise.jdx.dev
# Machine-local additions/overrides go in ~/.config/mise/config.local.toml (gitignored).

[tools]
# chezmoi manages this very file, so it must declare itself: bootstrap.sh runs
# `mise use -g chezmoi` (writing this file), then `chezmoi init --apply`
# overwrites it. Without this line chezmoi drops out of mise's tool list and the
# next `mise prune` removes its shim.
chezmoi = "latest"

# Editor — binary from mise; the AstroNvim config comes from the external repo
# (see .chezmoiexternal.toml). The Framework currently runs a 0.12 pre-release;
# pin a specific version here if the config ever needs more than the latest stable.
neovim = "latest"

# Runtimes (replace nvm / system go)
node = "lts"
go = "latest"
# Pinned to the current stable minor (floats patch releases): tools that embed
# python (mason builds black/isort venvs with it) need >= 3.10, and RHEL 9's
# system python stays 3.9 forever.
python = "3.14"

# Terminal multiplexer — from mise, not the system repo, because RHEL ships an
# old tmux (3.2a on RHEL 9) and the dotfiles assume a current one. Resolves to
# aqua:tmux/tmux-builds (prebuilt static binaries); the host must provide the
# tmux-256color terminfo entry (ncurses-term on RHEL minimal).
tmux = "latest"

# The coding agent the dev VM exists to run. Resolves to aqua:anthropics/claude-code
# (a native binary), deliberately not npm:@anthropic-ai/claude-code: npm globals live
# inside the active mise node install and silently vanish on a node bump. Upgrade with
# `mise up claude-code`; claude's own autoupdater cannot write into mise's install dir,
# so .zshrc turns it off.
claude-code = "latest"

# Claude Code token/cost reporting, reading the local ~/.claude JSONL logs.
# npm backend because upstream ships no binaries -- it is a Node CLI on npm only,
# so aqua/ubi have nothing to fetch. Unlike `npm install -g`, mise's npm backend
# installs into its own tool dir (installs/npm-ccusage/) rather than inside the
# active node install, so the caveat noted for claude-code above does not apply:
# a `node` bump leaves this in place. It still shebangs `#!/usr/bin/env node`, so
# it needs the `node` above on PATH at run time -- fine here, never for a machine
# that drops node from the toolchain.
"npm:ccusage" = "latest"

# Core terminal CLIs
ripgrep = "latest"
fd = "latest"
fzf = "latest"
bat = "latest"
jq = "latest"
lazygit = "latest"
gh = "latest"
glab = "latest"
uv = "latest"
starship = "latest"
trivy = "latest"
terraform = "latest"
shellcheck = "latest"

# Kubernetes
kubectl = "latest"
helm = "latest"
k9s = "latest"
k3d = "latest"
kind = "latest"

# Cloud
awscli = "latest"
"aqua:awslabs/eks-node-viewer" = "latest"

[settings]
# Don't auto-adopt .nvmrc/.python-version unless a project explicitly opts in.
idiomatic_version_file_enable_tools = []

# Supply-chain cooldown: with nearly every tool above on "latest", a compromised
# or broken release reaches us as soon as it clears the age floor. mise already
# defaults to 24h; a week gives the upstream project (and the wider ecosystem)
# realistic time to notice and yank a bad release before we install it.
# See https://mise.jdx.dev/security.html#minimum-release-age
minimum_release_age = "7d"

# claude-code is exempt, which drops it *below* the 24h default to no delay at
# all: it ships several releases a week and having the newest one is the point of
# this setup, so even a one-day lag is the wrong trade-off here. Deliberately the
# least-protected tool in this file. The shorthand matches the
# aqua:anthropics/claude-code backend ID resolved in [tools].
minimum_release_age_excludes = ["claude-code"]
