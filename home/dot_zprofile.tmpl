# ~/.zprofile — managed by chezmoi. Login-shell environment bootstrap.

{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# OrbStack CLI integration (added by OrbStack; harmless if removed).
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
{{- end }}
{{- if eq .chezmoi.os "linux" }}
# Nothing here on Linux: Linuxbrew is sourced from .zshrc instead, because
# Fedora's terminal emulators start non-login shells that never read .zprofile.
{{- end }}
