# ~/.zshrc — managed by chezmoi. Edit the source in PortableDevSetup, not this file.

# --- PATH ---------------------------------------------------------------
export PATH="$HOME/.local/scripts:$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "linux" }}

# Linuxbrew lives here rather than in .zprofile: Fedora's terminals start
# non-login shells, so .zprofile would only run inside tmux and brew would
# vanish from a bare terminal window. It must also precede `mise activate`
# below -- brew ships its own go, and whichever is sourced last wins PATH.
[ -d /home/linuxbrew/.linuxbrew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# --- oh-my-zsh ----------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                       # prompt is starship, set up below
CASE_SENSITIVE="false"
HYPHEN_INSENSITIVE="true"
zstyle ':omz:update' mode auto

# zsh-syntax-highlighting must load last; zsh-autosuggestions just before it.
plugins=(
  git docker kubectl helm argocd terraform opentofu vault ssh
{{- if eq .chezmoi.os "linux" }}
  systemd
{{- end }}
  zsh-autosuggestions
  zsh-syntax-highlighting
)
source "$ZSH/oh-my-zsh.sh"

# --- tools & prompt -----------------------------------------------------
# mise owns runtimes + CLI tools (replaces bob, nvm, cargo, go, bun PATH shims).
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"

ZSH_AUTOSUGGESTIONS_STRATEGY="history"

# --- editor -------------------------------------------------------------
# Prefer vim over SSH where a fully provisioned nvim may not be present.
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi
alias vim="nvim"

# --- fzf ----------------------------------------------------------------
command -v fzf >/dev/null && source <(fzf --zsh)
export FZF_DEFAULT_OPTS=" \
--color=bg+:#363a4f,bg:#24273a,spinner:#f4dbd6,hl:#ed8796 \
--color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6 \
--color=marker:#b7bdf8,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796 \
--color=selected-bg:#494d64,border:#6e738d,label:#cad3f5 \
--multi"

# tmux-sessionizer on Ctrl-f
bindkey -s ^f "tmux-sessionizer\n"

{{- if eq .chezmoi.os "darwin" }}

# --- macOS --------------------------------------------------------------
export HOMEBREW_NO_ENV_HINTS=1
{{- end }}
{{- if eq .chezmoi.os "linux" }}

# --- Linux --------------------------------------------------------------
export GPG_TTY=$(tty)
gpgconf --launch gpg-agent

# Ensure truecolor when not already inside tmux.
if [[ -z $TMUX ]]; then
  export TERM=xterm-256color
fi
{{- end }}

# --- machine-local ------------------------------------------------------
# Anything host-specific: hardware aliases, employer paths, toolchains this
# repo doesn't manage (cargo, bun, kubebuilder...). Unmanaged and untracked,
# so it never lands in this public repo. Sourced last so it can override.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
